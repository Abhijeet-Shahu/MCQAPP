<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvCongrats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Great work"
        android:textColor="@color/ink_light"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Score: 0 / 0"
        android:textColor="@color/ink_muted"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card"
        android:text="Retry Same Unit"
        android:textAllCaps="false"
        android:textColor="@color/ink_light"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnViewProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_option"
        android:text="View Progress"
        android:textAllCaps="false"
        android:textColor="@color/ink_dark"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnMainMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_option"
        android:text="Back to Main"
        android:textAllCaps="false"
        android:textColor="@color/ink_dark"
        android:textStyle="bold" />

</LinearLayout>
